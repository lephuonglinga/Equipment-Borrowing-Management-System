// ERD — import at https://dbdiagram.io

Table users {
  id int [pk, increment]
  email varchar(256) [unique, not null]
  password_hash varchar [not null]
  full_name varchar [not null]
  role int [not null]
  is_active bit [not null, default: true]
  created_at datetime [not null]
}

Table equipment_categories {
  id int [pk, increment]
  name varchar(100) [unique, not null]
  description varchar
  created_at datetime [not null]
}

Table equipments {
  id int [pk, increment]
  name varchar [not null]
  serial_number varchar [unique, not null]
  category_id int [not null, ref: > equipment_categories.id]
  status int [not null]
  location varchar
  description varchar
  created_at datetime [not null]
}

Table borrow_requests {
  id int [pk, increment]
  user_id int [not null, ref: > users.id]
  request_date datetime [not null]
  borrow_date datetime [not null]
  expected_return_date datetime [not null]
  status int [not null]
  purpose varchar [not null]
  reject_reason varchar
  approved_by_id int [ref: > users.id]
  approved_at datetime
  created_at datetime [not null]
}

Table borrow_request_items {
  id int [pk, increment]
  borrow_request_id int [not null, ref: > borrow_requests.id]
  equipment_id int [not null, ref: > equipments.id]
  quantity int [not null, default: 1]
  condition_at_borrow int
  condition_at_return int
  created_at datetime [not null]
}

Table return_records {
  id int [pk, increment]
  borrow_request_id int [unique, not null, ref: - borrow_requests.id]
  returned_at datetime [not null]
  returned_by_id int [not null, ref: > users.id]
  staff_note varchar
  overall_condition int [not null]
  created_at datetime [not null]
}

Table notifications {
  id int [pk, increment]
  user_id int [not null, ref: > users.id]
  title varchar [not null]
  message varchar [not null]
  type int [not null]
  is_read bit [not null, default: false]
  created_at datetime [not null]
}
