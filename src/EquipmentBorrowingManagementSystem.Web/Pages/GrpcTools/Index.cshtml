@page
@model EquipmentBorrowingManagementSystem.Web.Pages.GrpcTools.IndexModel
@{
    ViewData["Title"] = "gRPC Tools";
    ViewData["ActivePage"] = "grpc";
}

<div class="page-wrap">
    <div class="page-header">
        <div>
            <h1>gRPC Notification Tools</h1>
            <p class="subtitle">Gọi <code>EmailNotificationService.Send</code> từ web server tới gRPC host.</p>
        </div>
    </div>

    @if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
    {
        <div class="alert alert-error">@Model.ErrorMessage</div>
    }

    <form method="post" class="card card-accent">
        <div class="form-group">
            <label>User ID</label>
            <input asp-for="Input.UserId" type="number" min="1" required />
        </div>
        <div class="form-group">
            <label>User email</label>
            <input asp-for="Input.UserEmail" type="email" required />
        </div>
        <div class="form-group">
            <label>Title</label>
            <input asp-for="Input.Title" required />
        </div>
        <div class="form-group">
            <label>Message</label>
            <textarea asp-for="Input.Message" rows="4" required></textarea>
        </div>
        <div class="form-group">
            <label>Notification type</label>
            <input asp-for="Input.NotificationType" placeholder="BorrowApproved" required />
        </div>
        <button type="submit" class="btn btn-primary">Send RPC</button>
    </form>

    @if (Model.Result is not null)
    {
        <div class="section-title">Phản hồi gRPC</div>
        <pre class="grpc-result">Success: @Model.Result.Success
Detail: @Model.Result.Detail</pre>
    }
</div>
