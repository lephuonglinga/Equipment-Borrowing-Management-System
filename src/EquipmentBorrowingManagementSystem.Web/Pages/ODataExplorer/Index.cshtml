@page
@model EquipmentBorrowingManagementSystem.Web.Pages.ODataExplorer.IndexModel
@{
    ViewData["Title"] = "OData Explorer";
    ViewData["ActivePage"] = "odata";
}

<div class="page-wrap">
    <div class="page-header">
        <div>
            <h1>OData Explorer</h1>
            <p class="subtitle">Thử truy vấn OData trên API: Equipment và BorrowRequests.</p>
        </div>
    </div>

  <form method="post" class="card card-accent">
        <div class="form-group">
            <label>Entity set</label>
            <select name="entitySet">
                <option value="Equipment" selected="@(Model.EntitySet == "Equipment")">/odata/Equipment</option>
                <option value="BorrowRequests" selected="@(Model.EntitySet == "BorrowRequests")">/odata/BorrowRequests</option>
            </select>
        </div>
        <div class="form-group">
            <label>OData query (ví dụ: <code>?$filter=status eq 'Available'&amp;$top=5</code>)</label>
            <input name="query" value="@Model.Query" placeholder="?$filter=status eq 'Available'&$top=5" />
        </div>
        <button type="submit" class="btn btn-primary">Chạy truy vấn</button>
    </form>

    @if (Model.Result is not null)
    {
        <div class="section-title">Kết quả (HTTP @Model.Result.StatusCode)</div>
        @if (!string.IsNullOrWhiteSpace(Model.Result.ErrorMessage))
        {
            <div class="alert alert-error">@Model.Result.ErrorMessage</div>
        }
        <pre class="odata-result">@Model.Result.RawJson</pre>
    }
</div>
