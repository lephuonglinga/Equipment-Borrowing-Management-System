@page
@model EquipmentBorrowingManagementSystem.Web.Pages.Users.IndexModel
@{
    ViewData["Title"] = "Users";
    ViewData["ActivePage"] = "users";
}

<div class="page-wrap">
    <div class="page-header">
        <div>
            <h1>Users</h1>
            <p class="subtitle">Quản lý tài khoản Staff/User (Admin).</p>
        </div>
        <button type="button" class="btn btn-primary" onclick="document.getElementById('userModal').classList.add('open')">Thêm Staff</button>
    </div>

    @if (TempData["SuccessMessage"] is string success)
    {
        <div class="alert alert-success">@success</div>
    }
    @if (TempData["ErrorMessage"] is string error)
    {
        <div class="alert alert-error">@error</div>
    }

    @if (Model.Users.Count == 0)
    {
        <p class="empty-state">Chưa có user.</p>
    }
    else
    {
        <div class="data-table-wrap">
            <table class="data-table">
                <thead>
                    <tr><th>ID</th><th>Họ tên</th><th>Email</th><th>Role</th><th>Trạng thái</th><th>Ngày tạo</th><th></th></tr>
                </thead>
                <tbody>
                    @foreach (var u in Model.Users)
                    {
                        var isSelf = string.Equals(u.Email, Model.CurrentEmail, StringComparison.OrdinalIgnoreCase);
                        <tr class="clickable-row" onclick="window.location='@Url.Page("/Users/Detail", new { id = u.Id })'">
                            <td>@u.Id</td>
                            <td>@u.FullName</td>
                            <td>@u.Email</td>
                            <td>@u.Role</td>
                            <td>
                                @if (u.IsActive)
                                {
                                    <span class="status-badge status-available">Active</span>
                                }
                                else
                                {
                                    <span class="status-badge borrow-rejected">Inactive</span>
                                }
                            </td>
                            <td>@u.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy")</td>
                            <td class="table-actions" onclick="event.stopPropagation();">
                                <form method="post" asp-page-handler="ToggleActive">
                                    <input type="hidden" name="id" value="@u.Id" />
                                    <input type="hidden" name="activate" value="@(!u.IsActive)" />
                                    <button type="submit" class="btn btn-sm @(u.IsActive ? "btn-danger" : "btn-success")" disabled="@isSelf" title="@(isSelf ? "Không thể thao tác tài khoản đang đăng nhập" : "")">
                                        @(u.IsActive ? "Vô hiệu" : "Kích hoạt")
                                    </button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

<div class="modal-overlay" id="userModal">
    <div class="modal">
        <div class="modal-header">
            <h2>Tạo tài khoản Staff</h2>
            <button type="button" class="btn btn-neutral btn-sm" data-close>&times;</button>
        </div>
        <form method="post" asp-page-handler="Create" id="userCreateForm" novalidate>
            <div class="modal-body">
                <div class="form-group"><label>Họ tên</label><input name="fullName" id="staffFullName" required /></div>
                <div class="form-group"><label>Email</label><input name="email" id="staffEmail" type="email" required /></div>
                <div class="form-group"><label>Mật khẩu</label><input name="password" type="password" required minlength="6" /></div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-neutral" data-close>Hủy</button>
                <button type="submit" class="btn btn-primary">Tạo</button>
            </div>
        </form>
    </div>
</div>
