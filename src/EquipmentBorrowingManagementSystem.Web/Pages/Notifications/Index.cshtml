@page
@model EquipmentBorrowingManagementSystem.Web.Pages.Notifications.IndexModel
@{
    ViewData["Title"] = "Notifications";
    ViewData["ActivePage"] = "notifications";
}

<div class="page-wrap wide">
    <div class="card card-accent">
        <div class="page-header">
            <div>
                <h1>Notifications</h1>
                <p class="subtitle">Thông báo của bạn từ các sự kiện duyệt, từ chối, bàn giao, hoàn trả.</p>
            </div>
            <a class="detail-back" asp-page="/Categories/Index"><i class="fa-solid fa-arrow-left"></i> Quay lại Categories</a>
        </div>

        @if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
        {
            <div class="alert alert-error">@Model.ErrorMessage</div>
        }

        @if (Model.Notifications.Count == 0)
        {
            <div class="empty-state">
                <div class="placeholder-icon"><i class="fa-regular fa-bell"></i></div>
                <p>Bạn chưa có thông báo nào.</p>
            </div>
        }
        else
        {
            <div class="notification-list">
                @foreach (var n in Model.Notifications)
                {
                    <div class="notification-item @(n.IsRead ? "is-read" : "is-unread")">
                        <div class="notification-item-head">
                            <div>
                                <h3>@n.Title</h3>
                                <span class="notification-type">@n.Type</span>
                            </div>
                            <small>@n.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</small>
                        </div>
                        <p>@n.Message</p>
                        @if (!n.IsRead)
                        {
                            <form method="post" asp-page-handler="MarkRead" asp-route-id="@n.Id">
                                <button type="submit" class="btn btn-sm btn-primary">Đánh dấu đã đọc</button>
                            </form>
                        }
                    </div>
                }
            </div>
        }
    </div>
</div>
