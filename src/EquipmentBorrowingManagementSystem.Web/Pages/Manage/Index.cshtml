@page
@using EquipmentBorrowingManagementSystem.Web.Helpers
@using EquipmentBorrowingManagementSystem.Web.Infrastructure
@model EquipmentBorrowingManagementSystem.Web.Pages.Manage.IndexModel
@{
    ViewData["Title"] = "Quản lý";
    ViewData["ActivePage"] = "manage";
}

<div class="page-wrap manage-page">
    <div class="page-header">
        <div>
            <h1>Quản lý thiết bị &amp; danh mục</h1>
            <p class="subtitle">Staff — CRUD thiết bị và danh mục; Admin có thêm quyền quản lý Users.</p>
        </div>
    </div>

    <div class="tab-bar">
        <a asp-page="/Manage/Index" asp-route-tab="equipment" asp-route-status="@Model.StatusFilter" class="@(Model.ActiveTab == "equipment" ? "active" : "")">Thiết bị</a>
        <a asp-page="/Manage/Index" asp-route-tab="categories" class="@(Model.ActiveTab == "categories" ? "active" : "")">Danh mục</a>
    </div>

    @if (Model.ActiveTab == "equipment")
    {
        <div class="toolbar-row">
            <form method="get" class="toolbar-row" style="margin-bottom:0;">
                <input type="hidden" name="tab" value="equipment" />
                <div class="form-group">
                    <label>Lọc trạng thái</label>
                    <select name="status" onchange="this.form.submit()">
                        <option value="">Tất cả</option>
                        @foreach (var status in new[] { "Available", "Borrowed", "Maintenance", "Reserved", "Damaged", "Retired" })
                        {
                            if (Model.StatusFilter == status)
                            {
                                <option value="@status" selected>@status</option>
                            }
                            else
                            {
                                <option value="@status">@status</option>
                            }
                        }
                    </select>
                </div>
            </form>
            <button type="button" class="btn btn-primary" onclick="document.getElementById('equipmentModal').classList.add('open')">Thêm thiết bị</button>
        </div>

        @if (Model.EquipmentPage?.Items.Count > 0)
        {
            <div class="data-table-wrap">
                <table class="data-table">
                    <thead>
                        <tr><th>Tên</th><th>Serial</th><th>Danh mục</th><th>Trạng thái</th><th>Vị trí</th><th></th></tr>
                    </thead>
                    <tbody>
                        @foreach (var eq in Model.EquipmentPage.Items)
                        {
                            <tr>
                                <td>@eq.Name</td>
                                <td>@eq.SerialNumber</td>
                                <td>@eq.CategoryName</td>
                                <td>@Html.Raw(DisplayHelper.StatusBadge(eq.Status, "equipment"))</td>
                                <td>@(eq.Location ?? "—")</td>
                                <td class="table-actions">
                                    @if (eq.Status == "Maintenance")
                                    {
                                        <button type="button"
                                                class="btn btn-success btn-sm"
                                                data-open-maintenance
                                                data-equipment-id="@eq.Id"
                                                data-equipment-name="@eq.Name"
                                                data-status-filter="@Model.StatusFilter"
                                                data-page-number="@Model.PageNumber">
                                            Hoàn tất BT
                                        </button>
                                    }
                                    @if (FormValidation.CanEditEquipment(eq.Status))
                                    {
                                        <a class="btn btn-neutral btn-sm" asp-page="/Manage/Index" asp-route-tab="equipment" asp-route-editEquipmentId="@eq.Id" asp-route-status="@Model.StatusFilter" asp-route-pageNumber="@Model.PageNumber">Sửa</a>
                                    }
                                    @if (FormValidation.CanDeleteEquipment(eq.Status))
                                    {
                                        <form method="post" asp-page-handler="DeleteEquipment" onsubmit="return confirm('Xóa thiết bị này?');">
                                            <input type="hidden" name="id" value="@eq.Id" />
                                            <input type="hidden" name="tab" value="equipment" />
                                            <input type="hidden" name="status" value="@Model.StatusFilter" />
                                            <input type="hidden" name="pageNumber" value="@Model.PageNumber" />
                                            <button type="submit" class="btn btn-danger btn-sm">Xóa</button>
                                        </form>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            <div class="table-pager">
                <a class="btn btn-neutral btn-sm @(Model.EquipmentPage.HasPrevious ? "" : "disabled")" asp-page="/Manage/Index" asp-route-tab="equipment" asp-route-status="@Model.StatusFilter" asp-route-pageNumber="@(Model.PageNumber - 1)">Trước</a>
                <span>Trang @Model.EquipmentPage.PageNumber / @Model.EquipmentPage.TotalPages</span>
                <a class="btn btn-neutral btn-sm @(Model.EquipmentPage.HasNext ? "" : "disabled")" asp-page="/Manage/Index" asp-route-tab="equipment" asp-route-status="@Model.StatusFilter" asp-route-pageNumber="@(Model.PageNumber + 1)">Sau</a>
            </div>
        }
        else
        {
            <p class="empty-state">Chưa có thiết bị.</p>
        }
    }
    else
    {
        <div class="toolbar-row">
            <button type="button" class="btn btn-primary" onclick="document.getElementById('categoryModal').classList.add('open')">Thêm danh mục</button>
        </div>

        @if (Model.Categories.Count > 0)
        {
            <div class="data-table-wrap">
                <table class="data-table">
                    <thead><tr><th>Tên</th><th>Mô tả</th><th></th></tr></thead>
                    <tbody>
                        @foreach (var cat in Model.Categories)
                        {
                            <tr>
                                <td>@cat.Name</td>
                                <td>@(cat.Description ?? "—")</td>
                                <td class="table-actions">
                                    <a class="btn btn-neutral btn-sm" asp-page="/Manage/Index" asp-route-tab="categories" asp-route-editCategoryId="@cat.Id">Sửa</a>
                                    <form method="post" asp-page-handler="DeleteCategory" style="display:inline;" onsubmit="return confirm('Xóa danh mục này?');">
                                        <input type="hidden" name="id" value="@cat.Id" />
                                        <button type="submit" class="btn btn-danger btn-sm">Xóa</button>
                                    </form>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <p class="empty-state">Chưa có danh mục.</p>
        }
    }
</div>

<div class="modal-overlay @(Model.ShowEquipmentModal ? "open" : "")" id="equipmentModal">
    <div class="modal">
        <div class="modal-header">
            <h2>@(Model.EditEquipment is null ? "Thêm thiết bị" : "Sửa thiết bị")</h2>
            <a class="btn btn-neutral btn-sm" asp-page="/Manage/Index" asp-route-tab="equipment" asp-route-status="@Model.StatusFilter" asp-route-pageNumber="@Model.PageNumber">&times;</a>
        </div>
        <form method="post" asp-page-handler="SaveEquipment" id="equipmentForm" novalidate>
            <div class="modal-body">
                <input type="hidden" name="id" value="@Model.EditEquipment?.Id" />
                <input type="hidden" name="tab" value="equipment" />
                <input type="hidden" name="status" value="@Model.StatusFilter" />
                <input type="hidden" name="pageNumber" value="@Model.PageNumber" />
                <div class="form-group"><label>Tên</label><input name="name" id="equipmentName" value="@Model.EditEquipment?.Name" required /></div>
                <div class="form-group"><label>Serial</label><input name="serialNumber" id="equipmentSerial" value="@Model.EditEquipment?.SerialNumber" required /></div>
                <div class="form-group">
                    <label>Danh mục</label>
                    <select name="categoryId" id="equipmentCategory" required>
                        @foreach (var cat in Model.Categories)
                        {
                            if (Model.EditEquipment?.CategoryId == cat.Id)
                            {
                                <option value="@cat.Id" selected>@cat.Name</option>
                            }
                            else
                            {
                                <option value="@cat.Id">@cat.Name</option>
                            }
                        }
                    </select>
                </div>
                @if (Model.EditEquipment is not null)
                {
                    <div class="form-group">
                        <label>Trạng thái</label>
                        <select name="statusValue">
                            @foreach (var status in FormValidation.StaffSettableStatuses)
                            {
                                if (Model.EditEquipment.Status == status)
                                {
                                    <option value="@status" selected>@status</option>
                                }
                                else
                                {
                                    <option value="@status">@status</option>
                                }
                            }
                        </select>
                    </div>
                }
                <div class="form-group"><label>Vị trí</label><input name="location" id="equipmentLocation" value="@Model.EditEquipment?.Location" required /></div>
                <div class="form-group"><label>Mô tả</label><textarea name="description" rows="3">@Model.EditEquipment?.Description</textarea></div>
                <div class="form-group"><label>Image URL</label><input name="imageUrl" value="@Model.EditEquipment?.ImageUrl" /></div>
            </div>
            <div class="modal-footer">
                <a class="btn btn-neutral" asp-page="/Manage/Index" asp-route-tab="equipment" asp-route-status="@Model.StatusFilter" asp-route-pageNumber="@Model.PageNumber">Hủy</a>
                <button type="submit" class="btn btn-primary">Lưu</button>
            </div>
        </form>
    </div>
</div>

<div class="modal-overlay" id="maintenanceModal">
    <div class="modal">
        <div class="modal-header">
            <h2>Hoàn tất bảo trì</h2>
            <button type="button" class="btn btn-neutral btn-sm" data-close>&times;</button>
        </div>
        <form method="post" asp-page-handler="CompleteMaintenance" id="maintenanceForm">
            <input type="hidden" name="id" id="maintenanceEquipmentId" />
            <input type="hidden" name="tab" value="equipment" />
            <input type="hidden" name="status" id="maintenanceStatusFilter" />
            <input type="hidden" name="pageNumber" id="maintenancePageNumber" />
            <div class="modal-body">
                <p class="subtitle" style="margin-top:0;" id="maintenanceEquipmentName"></p>
                <div class="form-group">
                    <label for="maintenanceTargetStatus">Trạng thái sau bảo trì</label>
                    <select name="targetStatus" id="maintenanceTargetStatus" required>
                        @foreach (var status in FormValidation.MaintenanceCompleteStatuses)
                        {
                            <option value="@status">@status</option>
                        }
                    </select>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-neutral" data-close>Hủy</button>
                <button type="submit" class="btn btn-success">Xác nhận</button>
            </div>
        </form>
    </div>
</div>

<div class="modal-overlay @(Model.ShowCategoryModal ? "open" : "")" id="categoryModal">
    <div class="modal">
        <div class="modal-header">
            <h2>@(Model.EditCategory is null ? "Thêm danh mục" : "Sửa danh mục")</h2>
            <a class="btn btn-neutral btn-sm" asp-page="/Manage/Index" asp-route-tab="categories">&times;</a>
        </div>
        <form method="post" asp-page-handler="SaveCategory" id="categoryForm" novalidate>
            <div class="modal-body">
                <input type="hidden" name="id" value="@Model.EditCategory?.Id" />
                <div class="form-group"><label>Tên</label><input name="name" id="categoryName" value="@Model.EditCategory?.Name" required /></div>
                <div class="form-group"><label>Mô tả</label><textarea name="description" rows="3">@Model.EditCategory?.Description</textarea></div>
            </div>
            <div class="modal-footer">
                <a class="btn btn-neutral" asp-page="/Manage/Index" asp-route-tab="categories">Hủy</a>
                <button type="submit" class="btn btn-primary">Lưu</button>
            </div>
        </form>
    </div>
</div>
